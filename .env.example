# Optional OpenAI-compatible model. The production example uses Alibaba Cloud Bailian.
# Keep the API key server-side; never expose it through a NEXT_PUBLIC_ variable.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Optional official Fuyao provider. The MVP currently falls back to public market data when unavailable.
FUYAO_API_KEY=
DATA_MODE=auto
